{
  "agent": "alex",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 20,
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/office_hook.py\" SessionStart || true"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 40,
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/office_hook.py\" SubagentStart --publish || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 20,
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/office_hook.py\" PreToolUse || true"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/scope_guard.py\" --only lucas,sofia"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 20,
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/office_hook.py\" Notification || true"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 40,
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/office_hook.py\" SubagentStop --publish || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 40,
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/office_hook.py\" Stop --publish || true"
          }
        ]
      }
    ]
  }
}
